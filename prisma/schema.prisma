// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// 校舎（定例議題を校舎ごとに管理するための単位）
model Campus {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// category: "agenda" (議題) | "issue" (課題・共有) | "task" (個人タスク)
// status:   "todo" | "in_progress" | "done"
model Item {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String
  status      String    @default("todo")
  assignee    String?
  dueDate     DateTime?
  meetingWeek DateTime? // Monday of the target week; null = backlog (今後のストック)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([meetingWeek])
  @@index([assignee])
  @@index([category])
}

// 毎回の会議で確認する定型議題（目標人数・現状・体験数・アクションリスト）
// campusId = null は「校舎未選択」の従来データ。校舎を選ぶと校舎ごとに保存される。
model WeeklyReport {
  id              String   @id @default(cuid())
  meetingWeek     DateTime
  campusId        String?
  targetBySummer  Int?
  currentCount    Int?
  trialCount      Int?
  concreteActions String?
  internalActions String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 一意性は API 側（find → update/create）で担保する。
  @@index([meetingWeek, campusId])
}

model Comment {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now())

  @@index([itemId])
}
